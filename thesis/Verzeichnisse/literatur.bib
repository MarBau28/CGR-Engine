@inproceedings{mallettDeferredAdaptiveCompute2018,
  title = {Deferred Adaptive Compute Shading},
  booktitle = {Proceedings of the {{Conference}} on {{High-Performance Graphics}}},
  author = {Mallett, Ian and Yuksel, Cem},
  date = {2018-08-10},
  series = {{{HPG}} '18},
