  booktitle = {2020 {{IEEE}} 10th {{Symposium}} on {{Large Data Analysis}} and {{Visualization}} ({{LDAV}})},
  author = {Lukasczyk, Jonas and Garth, Christoph and Larsen, Matthew and Engelke, Wito and Hotz, Ingrid and Rogers, David and Ahrens, James and Maciejewski, Ross},
  date = {2020-10},
  pages = {37--41},
